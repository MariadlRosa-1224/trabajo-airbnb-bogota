# Copia este archivo como .env (cp .env.example .env) y completa los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# --- OBS: de dónde se descarga salidas_app.zip ---
# Endpoint del bucket: consola de OBS → tu bucket → Overview → Endpoint
OBS_ENDPOINT=obs.la-north-2.myhuaweicloud.com
OBS_BUCKET=airbnb-bogota-maria-2026
OBS_OBJETO=entrada/salidas_app.zip

# --- RDS for PostgreSQL ---
# IP privada: consola de RDS → tu instancia → Connectivity → Floating IP Address
PG_HOST=10.0.2.X
PG_PORT=5432
PG_USER=root
PG_PASSWORD=cambia_esto
PG_DB=airbnb
MB_DB=metabase

# --- IP pública (EIP) de la ECS ---
# MLflow solo responde a las direcciones permitidas aquí.
EIP=0.0.0.0
